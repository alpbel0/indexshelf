FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src PATH=/app/.venv/bin:$PATH INDEXSHELF_DATA_WORKER_PROFILE=metadata
WORKDIR /app
COPY apps/data/pyproject.toml apps/data/uv.lock ./
COPY apps/data/src ./src
RUN pip install --no-cache-dir uv==0.8.14 \
    && uv sync --frozen --no-dev --no-install-project \
    && groupadd --system --gid 10001 indexshelf \
    && useradd --system --uid 10001 --gid 10001 --no-create-home indexshelf
USER 10001:10001
ENTRYPOINT ["python", "-m", "indexshelf_data.apps.worker"]
