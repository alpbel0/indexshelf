FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY apps/backend/ ./apps/backend/
RUN dotnet restore apps/backend/IndexShelf.Backend.slnx
RUN dotnet publish apps/backend/src/Hosts/IndexShelf.DbMigrator/IndexShelf.DbMigrator.csproj \
    --no-restore --configuration Release --output /out

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
ENV DOTNET_EnableDiagnostics=0
COPY --from=build /out/ ./
USER 10001
ENTRYPOINT ["dotnet", "IndexShelf.DbMigrator.dll"]
