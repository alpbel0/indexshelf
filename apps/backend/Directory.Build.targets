<Project>
  <Target Name="ValidateBackendTargetFramework" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TargetFramework)' != 'net10.0'" Text="Backend projects must target net10.0." />
  </Target>

  <PropertyGroup>
    <IndexShelfContractsGeneratedRoot>$(MSBuildThisFileDirectory)..\..\contracts\generated\dotnet</IndexShelfContractsGeneratedRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'IndexShelf.ModuleContracts' and Exists('$(IndexShelfContractsGeneratedRoot)')">
    <Compile Include="$(IndexShelfContractsGeneratedRoot)\**\*.cs" Link="ContractsGenerated\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
