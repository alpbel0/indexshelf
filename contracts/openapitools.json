{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.12.0"
  },
  "generatorVersion": "7.12.0",
  "input": "openapi/mobile/v1/openapi.yaml",
  "generator": "kotlin",
  "output": "generated/kotlin",
  "additionalProperties": {
    "packageName": "com.indexshelf.contracts.generated",
    "serializationLibrary": "gson",
    "enumPropertyNaming": "original"
  },
  "globalProperties": {
    "models": "ProblemDetails,CursorPage",
    "apis": false,
    "supportingFiles": false
  }
}
