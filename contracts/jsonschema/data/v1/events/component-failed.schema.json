{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.indexshelf.dev/data/v1/events/component-failed.schema.json",
  "title": "Component Failed Event",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{ "$ref": "../common/event-envelope.schema.json" }],
  "required": ["message_id", "message_kind", "message_type", "message_version", "occurred_at", "correlation_id", "producer", "subject", "payload"],
  "properties": {
    "message_id": { "type": "string", "format": "uuid" }, "message_kind": { "const": "event" }, "message_type": { "const": "component.failed" }, "message_version": { "const": 1 },
    "occurred_at": { "$ref": "../common/trace-context.schema.json#/$defs/utcDateTime" }, "correlation_id": { "type": "string", "format": "uuid" }, "causation_id": { "type": ["string", "null"], "format": "uuid" }, "producer": { "const": "data" },
    "subject": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "component" }, "id": { "type": "string", "format": "uuid" } } },
    "payload": { "type": "object", "additionalProperties": false, "required": ["job_id", "component", "error"], "properties": { "job_id": { "type": "string", "format": "uuid" }, "component": { "type": "string", "enum": ["metadata", "static", "media", "outbox"] }, "error": { "$ref": "../common/error.schema.json" } } }
  }
}
